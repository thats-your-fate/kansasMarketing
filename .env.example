# Copy to .env for local development. Never commit a real .env file.

# Kansas backend API base URL (server-side only, never exposed to the browser).
BACKEND_API_URL=http://127.0.0.1:4008

# Public site origin. Indexing only ever turns on when this is a real
# https Kansas production hostname (see app/config.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3009
NEXT_PUBLIC_INDEXING_ENABLED=false

# Analytics (optional). Leave blank until a real Kansas GA4 property
# exists — do not reuse another state's measurement ID.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

PORT=3009
