# Copy to .env for local development. Never commit a real .env file.

# Kansas backend API base URL (server-side only, never exposed to the browser).
BACKEND_API_URL=http://127.0.0.1:4008

# Public site origin. Indexing only ever turns on when this is a real
# https Kansas production hostname (see app/config.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3009
NEXT_PUBLIC_INDEXING_ENABLED=false

# Analytics (optional). Enable only when you intentionally want local GA4 hits.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-KPB1SGQDXV
NEXT_PUBLIC_CLARITY_PROJECT_ID=ysg743uoy3
NEXT_PUBLIC_ANALYTICS_ENABLED=false

PORT=3009

# Admin two-factor sign-in (see docs/admin-two-factor.md). Server-side only; all three are
# required for any admin sign-in, the enrollment code only while someone must enroll.
# Never commit real values. In production they live in the protected web environment file.
# 64 hex characters (openssl rand -hex 32): encrypts the stored authenticator secret.
# KANSAS_ADMIN_TOTP_KEY=
# At least 16 characters, owner-issued; leave unset to keep enrollment closed.
# KANSAS_ADMIN_TOTP_ENROLLMENT_CODE=
# Absolute path of the JSON state file, in a directory only the web process user can write.
# KANSAS_ADMIN_TOTP_STATE_FILE=
