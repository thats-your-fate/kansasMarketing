[Unit]
Description=Future Wells Kansas public web frontend
After=network-online.target future-wells-ks-api.service
Wants=network-online.target future-wells-ks-api.service

[Service]
Type=simple
WorkingDirectory=/home/yaro/projects/kansasMarketing
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3009
Environment=BACKEND_API_URL=http://127.0.0.1:4008
Environment=NEXT_PUBLIC_SITE_URL=https://futurewellskansas.com
Environment=NEXT_PUBLIC_INDEXING_ENABLED=true
Environment=NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-KPB1SGQDXV
Environment=NEXT_PUBLIC_CLARITY_PROJECT_ID=ysg743uoy3
Environment=NEXT_PUBLIC_ANALYTICS_ENABLED=true
ExecStart=/usr/bin/env NEXT_DIST_DIR=.next-production-v1 /usr/bin/node /home/yaro/projects/kansasMarketing/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3009
Restart=on-failure
RestartSec=5
SyslogIdentifier=future-wells-ks-web
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
MemoryAccounting=true
MemoryMax=768M
MemoryHigh=640M
TasksMax=256

[Install]
WantedBy=default.target
